{
  "name": "Business Concierge & Store Agent - WhatsApp and Telegram",
  "nodes": [
    {
      "id": "8e6ffde1-5ae6-48e6-843e-8e2eed0e548b",
      "name": "Business Concierge Architecture",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        160,
        40
      ],
      "parameters": {
        "content": "## 💼 Omnichannel Business Concierge & Digital Store Bot (WhatsApp + Telegram)\n\n**Key Systems:**\n1. **Omnichannel Ingestion**: Ingests WhatsApp & Telegram customer chats into a unified normalized schema.\n2. **Natural Conversational AI**: High-empathy, human-like sales rep tone (never robotic), answers product & order inquiries.\n3. **Live Store Lookup**: Real-time catalog search, pricing, stock levels, order tracking.\n4. **Sentiment & Feedback Engine**: Automatically evaluates satisfaction, records reviews, and triggers emergency escalation to owner if angry/urgent.",
        "height": 220,
        "width": 780,
        "color": 5
      }
    },
    {
      "id": "a8ae110f-7f57-476e-bc58-9c2a7553d93e",
      "name": "WhatsApp Inbound Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [
        200,
        320
      ],
      "parameters": {
        "updates": [
          "messages"
        ]
      },
      "credentials": {
        "whatsAppApi": {
          "id": "WHATSAPP_BUSINESS_CREDENTIAL_ID",
          "name": "WhatsApp Business Cloud Account"
        }
      }
    },
    {
      "id": "a55c5b8f-da5a-4386-8bdb-ab62f02e7653",
      "name": "Telegram Customer Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        520
      ],
      "parameters": {
        "updates": [
          "message"
        ]
      },
      "credentials": {
        "telegramApi": {
          "id": "BUSINESS_TELEGRAM_BOT_CREDENTIAL_ID",
          "name": "Business Telegram Bot Account"
        }
      }
    },
    {
      "id": "8a9a89ff-49a5-408f-b96e-443767646c71",
      "name": "Omnichannel Normalizer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        420
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Normalizes payloads from WhatsApp Business Cloud API vs Telegram Bot\nconst item = $input.item.json;\n\nlet channel = 'unknown';\nlet senderId = '';\nlet senderName = 'Valued Customer';\nlet messageText = '';\nlet senderContact = '';\n\nif (item.messages && item.messages[0]) {\n  // WhatsApp Cloud API payload\n  channel = 'whatsapp';\n  const msg = item.messages[0];\n  senderId = msg.from;\n  senderContact = msg.from;\n  messageText = msg.text ? msg.text.body : (msg.caption || '[Media Message]');\n  if (item.contacts && item.contacts[0] && item.contacts[0].profile) {\n    senderName = item.contacts[0].profile.name;\n  }\n} else if (item.message) {\n  // Telegram payload\n  channel = 'telegram';\n  senderId = String(item.message.chat.id);\n  senderName = [item.message.from.first_name, item.message.from.last_name].filter(Boolean).join(' ') || item.message.from.username || 'Customer';\n  senderContact = item.message.from.username ? `@${item.message.from.username}` : senderId;\n  messageText = item.message.text || item.message.caption || '[Media Message]';\n}\n\nreturn {\n  json: {\n    channel,\n    senderId,\n    senderName,\n    senderContact,\n    messageText,\n    timestamp: new Date().toISOString()\n  }\n};"
      }
    },
    {
      "id": "990dfbf4-dc26-4a15-b71f-7f6694cc4a5e",
      "name": "Concierge LLM (GPT-4o)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
