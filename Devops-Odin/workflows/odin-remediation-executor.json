{
  "name": "Odin - Remediation Executor",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "1",
      "name": "When Action Dispatched",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{ $json.actionType }}",
                    "operation": "startsWith",
                    "value2": "docker"
                  }
                ]
              }
            },
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{ $json.actionType }}",
                    "operation": "startsWith",
                    "value2": "azure"
                  }
                ]
              }
            },
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{ $json.actionType }}",
                    "operation": "startsWith",
                    "value2": "github"
                  }
                ]
              }
            }
          ]
        }
      },
      "id": "2",
      "name": "Route by Provider",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [440, 300]
    },
    {
      "parameters": {
        "command": "=docker restart {{ $json.service }}"
      },
      "id": "3",
      "name": "Docker Restart (SSH)",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [720, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://management.azure.com/subscriptions/{{ $env.AZURE_SUBSCRIPTION_ID }}/resourceGroups/{{ $env.AZURE_RESOURCE_GROUP }}/providers/Microsoft.App/containerApps/{{ $json.service }}/restart?api-version=2023-05-01",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "4",
      "name": "Azure Container Restart",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.github.com/repos/{{ $env.GITHUB_OWNER }}/{{ $env.GITHUB_REPO }}/actions/workflows/deploy.yml/dispatches",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"ref\": \"main\",\n  \"inputs\": {\n    \"reason\": \"Odin automated rollback\"\n  }\n}",
        "options": {}
      },
      "id": "5",
      "name": "GitHub Rollback Dispatch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 420]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nreturn [{\n  json: {\n    auditId: `aud_${Date.now()}`,\n    timestamp: new Date().toISOString(),\n    status: 'COMPLETED',\n    actionType: input.actionType,\n    service: input.service,\n    result: input\n  }\n}];"
      },
      "id": "6",
      "name": "Record Audit Log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [980, 300]
    }
  ],
  "connections": {
    "When Action Dispatched": {
      "main": [
        [
          {
            "node": "Route by Provider",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route by Provider": {
      "main": [
        [
          {
            "node": "Docker Restart (SSH)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Azure Container Restart",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "GitHub Rollback Dispatch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Docker Restart (SSH)": {
      "main": [
        [
          {
            "node": "Record Audit Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Azure Container Restart": {
      "main": [
        [
          {
            "node": "Record Audit Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub Rollback Dispatch": {
      "main": [
        [
          {
            "node": "Record Audit Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
